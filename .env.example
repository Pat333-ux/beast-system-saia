# Application Environment
NODE_ENV=development
PORT=8080

# Database Configuration (PostgreSQL / Cloud SQL)
DATABASE_URL=postgres://saia_user:saia_password@localhost:5432/beast_saia

# Web3 / Smart Contract Configuration (Sepolia / Ethereum)
RPC_URL=https://rpc.sepolia.org
GOVERNOR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Security & Audit API Keys
AUDIT_WEBHOOK_SECRET=your_secure_webhook_secret_here
